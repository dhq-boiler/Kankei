<Window x:Class="Kankei.Desktop.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kankei のバージョン情報" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/Icons/kankei.ico">
    <StackPanel Margin="32">
        <Grid Margin="0,0,0,26">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Image Source="pack://application:,,,/Assets/Icons/kankei-512.png" Width="88" Height="88" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,22,0" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Kankei" FontFamily="Segoe UI" FontSize="32" FontWeight="SemiBold" />
                <TextBlock Text="還景 — いつもの作業環境へ。" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,9" />
                <Border Background="#20334C" CornerRadius="5" Padding="9,4" HorizontalAlignment="Left"><TextBlock x:Name="VersionText" AutomationProperties.AutomationId="AppVersion" Foreground="#BAD5FC" FontSize="12" /></Border>
            </StackPanel>
        </Grid>
        <Border Style="{StaticResource Card}" Padding="22">
            <StackPanel>
                <TextBlock Text="アップデート" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="UpdateStatus" AutomationProperties.AutomationId="UpdateStatus" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="23" Margin="0,12,0,20" />
                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,18" />
                <CheckBox x:Name="AutomaticUpdates" AutomationProperties.AutomationId="AutomaticUpdates" Content="自動アップデート" Click="AutomaticUpdatesClick" />
                <TextBlock Text="新しいバージョンを取得し、アプリ終了時に適用します。" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="30,7,0,20" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button x:Name="CheckUpdates" Content="更新を確認" AutomationProperties.AutomationId="CheckUpdates" Click="CheckUpdatesClick" />
                    <Button Grid.Column="1" x:Name="ApplyUpdate" Content="今すぐ更新して再起動" AutomationProperties.AutomationId="ApplyUpdate" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="ApplyUpdateClick" />
                </Grid>
            </StackPanel>
        </Border>
        <Grid Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="Built by dhq-boiler" Foreground="{StaticResource MutedBrush}" FontSize="12" /><Button Content="GitHub / リリース ↗" AutomationProperties.AutomationId="OpenReleases" HorizontalAlignment="Left" Padding="0,6" Background="Transparent" BorderThickness="0" Foreground="#81B6FF" Click="OpenReleasesClick" /></StackPanel>
            <Button Grid.Column="1" Content="閉じる" AutomationProperties.AutomationId="CloseAbout" VerticalAlignment="Center" MinWidth="86" IsCancel="True" Click="CloseClick" />
        </Grid>
    </StackPanel>
</Window>
