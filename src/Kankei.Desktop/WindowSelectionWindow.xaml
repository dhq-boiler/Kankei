<Window x:Class="Kankei.Desktop.WindowSelectionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i18n="clr-namespace:Kankei.Desktop" xmlns:local="clr-namespace:Kankei.Desktop"
 Title="{i18n:Translate 'Kankei — 配置の保存・復元'}" Width="1100" Height="850" MinWidth="800" MinHeight="760"
 Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/Icons/kankei.ico">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,24">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Language" AutomationProperties.AutomationId="Language" Click="LanguageClick" Margin="0,0,10,0" />
                <Button Content="{i18n:Translate 'バージョン情報'}" AutomationProperties.AutomationId="OpenAbout" Click="OpenAboutClick" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/Icons/kankei-512.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,14,0" />
                <StackPanel><TextBlock Text="Kankei" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="27" /><TextBlock Text="{i18n:Translate 'いつもの作業環境へ、すぐに。'}" Foreground="{StaticResource MutedBrush}" /></StackPanel>
            </StackPanel>
        </DockPanel>

  <local:MonitorPreview x:Name="Preview" Grid.Row="1"/>
  <StackPanel x:Name="ProfileBar" Grid.Row="2" Margin="0,22,0,0">
   <TextBlock Text="{i18n:Translate '配置を選択'}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ComboBox x:Name="SavedLayouts" AutomationProperties.AutomationId="SavedLayouts" AutomationProperties.Name="{i18n:Translate '配置を選択'}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="RestoreSelectionChanged">
     <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/><Setter Property="AutomationProperties.AutomationId" Value="{Binding Id}"/></Style></ComboBox.ItemContainerStyle>
    </ComboBox>
    <Button x:Name="LayoutActionsButton" Grid.Column="1" Content="•••" FontSize="16" MinWidth="48" Margin="10,0" IsEnabled="False" Click="LayoutActionsClick" AutomationProperties.AutomationId="LayoutActions" AutomationProperties.Name="{i18n:Translate '配置の操作'}" ToolTip="{i18n:Translate '配置の操作 — 復元・保存し直し・API連携・削除'}"/>
    <Button Grid.Column="2" Content="{i18n:Translate '＋ 新規配置'}" Style="{StaticResource PrimaryButton}" Click="NewLayoutClick" AutomationProperties.AutomationId="NewLayout"/>
   </Grid>
   <TextBlock x:Name="Status" AutomationProperties.AutomationId="LayoutStatus" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </StackPanel>
 </Grid>
</Window>

