<Window x:Class="Kankei.Desktop.WindowSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Kankei.Desktop"
        Title="Kankei — 配置の保存・復元" Width="1360" Height="860" MinWidth="1120" MinHeight="720"
        Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/Icons/kankei.ico">
    <Grid Margin="28">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,24">
            <Button DockPanel.Dock="Right" Content="バージョン情報" AutomationProperties.AutomationId="OpenAbout" Click="OpenAboutClick" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/Icons/kankei-512.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,14,0" />
                <StackPanel><TextBlock Text="Kankei" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="27" /><TextBlock Text="いつもの作業環境へ、すぐに。" Foreground="{StaticResource MutedBrush}" /></StackPanel>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,22">
            <StackPanel>
                <DockPanel Margin="0,0,0,14"><TextBlock Text="配置を復元" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="保存したプロファイルから" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,0,0" /></DockPanel>
                <Grid x:Name="RestorePanel">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ComboBox x:Name="SavedLayouts" AutomationProperties.AutomationId="SavedLayouts" AutomationProperties.Name="復元するレイアウト" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="RestoreSelectionChanged">
                        <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Name}" /><Setter Property="AutomationProperties.AutomationId" Value="{Binding Id}" /></Style></ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <Button Grid.Column="1" Content="更新" Click="RefreshLayoutsClick" Margin="10,0" />
                    <Button Grid.Column="2" x:Name="RestoreButton" AutomationProperties.AutomationId="RestoreSelected" Content="復元" Style="{StaticResource PrimaryButton}" Click="RestoreClick" IsEnabled="False" />
                </Grid>
                <DockPanel Margin="0,12,0,0" LastChildFill="False">
                    <Button x:Name="DeleteLayoutButton" DockPanel.Dock="Right" Content="削除" AutomationProperties.AutomationId="DeleteLayout" Click="DeleteLayoutClick" IsEnabled="False" ToolTip="選択したプロファイルを削除" />
                    <Button x:Name="CopyApiButton" Content="API URLをコピー" AutomationProperties.AutomationId="CopyRestoreApi" Click="CopyApiClick" IsEnabled="False" ToolTip="POSTで呼び出す復元APIのURLをコピーします。コピーだけでは復元しません。" />
                    <Button x:Name="CopyCurlButton" Content="curlをコピー" AutomationProperties.AutomationId="CopyRestoreCurl" Click="CopyCurlClick" IsEnabled="False" Margin="8,0,0,0" ToolTip="PowerShellで実行できるcurl.exeのPOSTコマンドをコピーします。" />
                </DockPanel>
                <TextBlock x:Name="RestoreStatusText" AutomationProperties.AutomationId="RestoreStatus" Text="保存済みの配置を読み込み中…" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="今の配置を保存" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="残したいウィンドウを選択してください。" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" /></StackPanel>
            <Button Grid.Column="1" Content="一覧を更新" Click="RefreshClick" VerticalAlignment="Center" />
        </Grid>
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="WindowList" Margin="10,2" /></ScrollViewer>
        </Border>
        <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <CheckBox x:Name="IncludeYouTube" AutomationProperties.AutomationId="IncludeYouTube" IsChecked="True" Content="YouTube の再生リスト・再生位置・一時停止状態も保存" Margin="0,0,0,18" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0"><TextBlock Text="プロファイル名" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" /><TextBox x:Name="LayoutName" AutomationProperties.AutomationId="LayoutName" Text="default" /></StackPanel>
                <Button Grid.Column="1" Content="閉じる" Click="CloseClick" VerticalAlignment="Bottom" Margin="0,0,10,0" />
                <Button Grid.Column="2" x:Name="SaveButton" AutomationProperties.AutomationId="SaveSelection" Content="選択した配置を保存" Style="{StaticResource PrimaryButton}" Click="SaveClick" VerticalAlignment="Bottom" IsEnabled="False" />
            </Grid>
            <TextBlock x:Name="Status" AutomationProperties.AutomationId="SelectionStatus" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
        <local:MonitorPreview x:Name="Preview" Grid.Column="2" Grid.Row="1" Grid.RowSpan="4" />
    </Grid>
</Window>

