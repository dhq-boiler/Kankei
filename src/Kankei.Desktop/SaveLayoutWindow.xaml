<Window x:Class="Kankei.Desktop.SaveLayoutWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i18n="clr-namespace:Kankei.Desktop" xmlns:local="clr-namespace:Kankei.Desktop"
 Title="{i18n:Translate '配置を保存'}" Width="1160" Height="760" MinWidth="1040" MinHeight="660"
 Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="pack://application:,,,/Assets/Icons/kankei.ico">
 <Grid Margin="24">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid x:Name="Editor">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="{i18n:Translate '今の配置を保存'}" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="{i18n:Translate '残したいウィンドウを選択してください。'}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" /></StackPanel>
            <Button Grid.Column="1" Content="{i18n:Translate '一覧を更新'}" Click="RefreshClick" VerticalAlignment="Center" />
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="WindowList" Margin="10,2" /></ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <CheckBox x:Name="IncludeYouTube" AutomationProperties.AutomationId="IncludeYouTube" IsChecked="True" Content="{i18n:Translate 'YouTube の再生リスト・再生位置・一時停止状態も保存'}" Margin="0,0,0,18" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0"><TextBlock Text="{i18n:Translate 'プロファイル名'}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" /><TextBox x:Name="LayoutName" AutomationProperties.AutomationId="LayoutName" Text="default" /></StackPanel>
                <Button Grid.Column="1" Content="{i18n:Translate '閉じる'}" Click="CloseClick" AutomationProperties.AutomationId="CloseSave" VerticalAlignment="Bottom" Margin="0,0,10,0" />
                <Button Grid.Column="2" x:Name="SaveButton" AutomationProperties.AutomationId="SaveSelection" Content="{i18n:Translate '選択した配置を保存'}" Style="{StaticResource PrimaryButton}" Click="SaveClick" VerticalAlignment="Bottom" IsEnabled="False" />
            </Grid>
            <TextBlock x:Name="Status" AutomationProperties.AutomationId="SelectionStatus" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>

  </Grid>
  <local:MonitorPreview x:Name="Preview" Grid.Column="2"/>
 </Grid>
</Window>
